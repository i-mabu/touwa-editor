{
  "name": "touwa-editor",
  "version": "0.1.0",
  "description": "A secure, extensible desktop code editor foundation.",
  "main": "out/main/main.js",
  "author": "Touwa Editor contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:electron": "node scripts/verify-electron.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "test": "node --test scripts/test-phase2.mjs scripts/test-tabs.mjs scripts/test-vscode-ux.mjs scripts/test-phase3.mjs scripts/test-phase4.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "build": "electron-vite build",
    "package": "electron-builder --publish never",
    "preview": "electron-vite preview",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.touwa.editor",
    "productName": "Touwa Editor",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
